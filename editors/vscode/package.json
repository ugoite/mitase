{
  "name": "mitase-vscode",
  "displayName": "mitase",
  "description": "FEAT-VSCODE-001 Surface mitase validation diagnostics and trace navigation inside VS Code.",
  "version": "0.0.1-alpha.8",
  "publisher": "ugoite",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20 <21"
  },
  "packageManager": "npm@11.8.0",
  "categories": [
    "Other"
  ],
  "keywords": [
    "mitase",
    "specification",
    "traceability",
    "requirements"
  ],
  "activationEvents": [
    "workspaceContains:mitase.yaml",
    "workspaceContains:docs/mitase/features/features.yaml",
    "workspaceContains:features/features.yaml",
    "onCommand:mitase.refreshDiagnostics",
    "onCommand:mitase.showTraceForActiveFile",
    "onCommand:mitase.openSpecItemById",
    "onCommand:mitase.showRelatedFilesForSpecId",
    "onView:mitaseContext"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/model.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "mitase.refreshDiagnostics",
        "title": "mitase: Refresh diagnostics"
      },
      {
        "command": "mitase.showTraceForActiveFile",
        "title": "mitase: Trace active file"
      },
      {
        "command": "mitase.openSpecItemById",
        "title": "mitase: Open spec item by ID"
      },
      {
        "command": "mitase.showRelatedFilesForSpecId",
        "title": "mitase: Show related files for spec ID"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mitaseContext",
          "name": "mitase Context"
        }
      ]
    },
    "configuration": {
      "title": "mitase",
      "properties": {
        "mitase.binaryPath": {
          "type": "string",
          "default": "mitase",
          "markdownDescription": "Path to the `mitase` CLI binary that powers validation diagnostics."
        },
        "mitase.autoRefreshDiagnostics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Refresh `mitase` diagnostics after saving a file inside a mitase workspace."
        }
      }
    }
  }
}
