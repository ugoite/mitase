{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "mitase",
      "include-v-in-tag": true,
      "changelog-type": "github",
      "extra-files": [
        {
          "type": "generic",
          "file": "scripts/install-mitase.sh",
          "replacers": [
            {
              "search": "DEFAULT_VERSION_SELECTOR=\"__MITASE_RELEASE_TAG__\"",
              "replace": "DEFAULT_VERSION_SELECTOR=\"v{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "README.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nRELEASE=v(?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nRELEASE=v{{version}}\n# x-release-please-end"
            },
            {
              "search": "# x-release-please-start-version\n\\$release = 'v(?<version>.*)'\n# x-release-please-end",
              "replace": "# x-release-please-start-version\n$release = 'v{{version}}'\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/start-here/first-run/getting-started.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nRELEASE=v(?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nRELEASE=v{{version}}\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/workflows/repository/configuration.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nversion: (?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nversion: {{version}}\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/start-here/adopt/existing-repository.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nversion: (?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nversion: {{version}}\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "website/package.json",
          "replacers": [
            {
              "search": "\"version\": \"(?<version>.*)\"",
              "replace": "\"version\": \"{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "editors/vscode/package.json",
          "replacers": [
            {
              "search": "\"version\": \"(?<version>.*)\"",
              "replace": "\"version\": \"{{version}}\""
            }
          ]
        }
      ]
    }
  }
}
