{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "syu",
      "include-v-in-tag": true,
      "changelog-type": "github",
      "extra-files": [
        {
          "type": "generic",
          "file": "scripts/install-syu.sh",
          "replacers": [
            {
              "search": "DEFAULT_VERSION_SELECTOR=\"v(?<version>.*)\"",
              "replace": "DEFAULT_VERSION_SELECTOR=\"v{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "README.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nRELEASE=v(?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nRELEASE=v{{version}}\n# x-release-please-end"
            },
            {
              "search": "# x-release-please-start-version\n\\$release = 'v(?<version>.*)'\n# x-release-please-end",
              "replace": "# x-release-please-start-version\n$release = 'v{{version}}'\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/guide/getting-started.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nRELEASE=v(?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nRELEASE=v{{version}}\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/guide/configuration.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nversion: (?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nversion: {{version}}\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/guide/existing-repository.md",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nversion: (?<version>.*)\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nversion: {{version}}\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/syu/features/features.yaml",
          "replacers": [
            {
              "search": "# x-release-please-start-version\nversion: \"(?<version>.*)\"\n# x-release-please-end",
              "replace": "# x-release-please-start-version\nversion: \"{{version}}\"\n# x-release-please-end"
            }
          ]
        },
        {
          "type": "generic",
          "file": "docs/generated/site-spec/features/features.md",
          "replacers": [
            {
              "search": "### Version\n\n- (?<version>.*)\n\n### Updated",
              "replace": "### Version\n\n- {{version}}\n\n### Updated"
            },
            {
              "search": "version: \"(?<version>.*)\"",
              "replace": "version: \"{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "website/package.json",
          "replacers": [
            {
              "search": "\"version\": \"(?<version>.*)\"",
              "replace": "\"version\": \"{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "editors/vscode/package.json",
          "replacers": [
            {
              "search": "\"version\": \"(?<version>.*)\"",
              "replace": "\"version\": \"{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "crates/syu-core/Cargo.toml",
          "replacers": [
            {
              "search": "name = \"syu-core\"\nversion = \"(?<version>.*)\"",
              "replace": "name = \"syu-core\"\nversion = \"{{version}}\""
            }
          ]
        },
        {
          "type": "generic",
          "file": "examples/rust-only/syu.yaml",
          "replacers": [
            {
              "search": "^version: (?<version>.*)$",
              "replace": "version: {{version}}"
            }
          ]
        },
        {
          "type": "generic",
          "file": "examples/browser-ui/syu.yaml",
          "replacers": [
            {
              "search": "^version: (?<version>.*)$",
              "replace": "version: {{version}}"
            }
          ]
        },
        {
          "type": "generic",
          "file": "examples/csharp-fallback/syu.yaml",
          "replacers": [
            {
              "search": "^version: (?<version>.*)$",
              "replace": "version: {{version}}"
            }
          ]
        },
        {
          "type": "generic",
          "file": "examples/generic/syu.yaml",
          "replacers": [
            {
              "search": "^version: (?<version>.*)$",
              "replace": "version: {{version}}"
            }
          ]
        },
        {
